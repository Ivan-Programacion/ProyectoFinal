<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos para que Android 13 en adelante permita notificaciones -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Permisos para que Android pueda acceder a internet (para los videos) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/logo_vector"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/logo_vector"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProyectoFinal">
        <!-- android:screenOrientation="portrait" -> para evitar giro de pantalla -->
        <!-- android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" -> en caso de querer girar la pantalla a horizontal, que no resetee la app -->
        <activity
            android:name=".ViewModel.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.App.Starting"> <!-- Se añade el nombre de la etiqueta del Theme para la pantalla de carga-->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Añadimos la clase que gestionará el servicio de las notificaciones y manejará la cola de mensajes push -->
        <service
            android:name=".Services.MyFirebaseMessagingService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>